# Browser-visible configuration only. Never put server secrets in a VITE_ variable.

# Empty means same-origin `/api` and `/uploads` requests in production.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=20000

# Local development proxy target; this value is not shipped to the browser bundle.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:5001
