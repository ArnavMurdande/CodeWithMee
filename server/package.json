    "db:restore": "node scripts/restore-portable-backup.js",
    "identity:diagnose": "node scripts/diagnose-identity-config.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "files:cleanup": "node scripts/cleanup-files.js",
    "files:reconcile": "node scripts/reconcile-files.js",
    "health:synthetic": "node scripts/run-synthetic-health.js",
    "migration:parity": "node scripts/create-persistence-parity-report.js",
    "openapi:export": "node scripts/export-openapi.js",
    "persistence:cutover": "node scripts/persistence-cutover.js",
    "test": "node --test test/*.test.js",
    "test:database:integration": "node test/database-lifecycle.js",
    "test:database:integration:target": "node test/database-integration.js",
    "test:backup:integration": "node test/portable-backup-integration.js",
    "test:watch": "node --test --watch test/*.test.js"
