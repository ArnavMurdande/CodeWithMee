  "main": "index.js",
  "scripts": {
    "bootstrap:superadmin": "node scripts/bootstrap-superadmin.js",
    "db:format": "prisma format --schema ../prisma/schema.prisma",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:deploy": "node scripts/run-database-command.js migrate-deploy",
    "db:seed": "node scripts/run-database-command.js seed",
