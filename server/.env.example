NODE_ENV=development
HOST=0.0.0.0
PORT=5001

# Required for database-backed routes. Never commit a real connection string.
MONGO_URI=mongodb://127.0.0.1:27017/codewithmee

# Phase 0C PostgreSQL target. Mongoose remains the default until the authenticated parity,
# freeze, activation-record and rollback gates below all agree.
# Mutation commands also require DATABASE_SAFETY_SCOPE. Never reuse a production database locally.
DATABASE_URL=
SHADOW_DATABASE_URL=
# DATABASE_SAFETY_SCOPE=disposable
# DATABASE_DEPLOY_APPROVAL=staging:codewithmee_staging

# Authenticated portable logical backup. Production must also use managed PITR and a native
# pg_dump/pg_restore custom-format backup; this bounded archive is the cross-provider verifier.
# Export approval: backup:<database>:<schema-sha256>
# Restore approval: restore:<different-empty-database>:<archive-sha256>
DATABASE_BACKUP_SCOPE=disposable
DATABASE_BACKUP_MODE=
DATABASE_BACKUP_APPROVAL=
DATABASE_BACKUP_KEY=
DATABASE_RESTORE_MODE=
DATABASE_RESTORE_APPROVAL=

# P0C source-inventory/export tooling. These never fall back to MONGO_URI.
# Use a dedicated Mongo account with only read access. Approval must name the URI database.
MIGRATION_SOURCE_MONGO_URI=
MIGRATION_SOURCE_MODE=read_only
# MIGRATION_SOURCE_APPROVAL=read-only:codewithmee
# Independent canonical base64-encoded 32-byte keys; keep them outside source control.
MIGRATION_EXPORT_KEY=
MIGRATION_FINGERPRINT_KEY=

# Guarded PostgreSQL snapshot import. The approval contains the full authenticated dataset hash:
# import:<database>:<64-character-dataset-sha256>. Production/staging also require write freeze.
MIGRATION_IMPORT_MODE=
MIGRATION_IMPORT_APPROVAL=
MIGRATION_IMPORT_MAX_RECORDS=250000
MIGRATION_WRITE_FREEZE_CONFIRMED=false

# Read-only reconciliation report. The approval names the target database and authenticated
# migration dataset; the key is an independent canonical base64-encoded 32-byte HMAC key.
PERSISTENCE_PARITY_MODE=
PERSISTENCE_PARITY_APPROVAL=
PERSISTENCE_PARITY_KEY=

# Runtime persistence authority. Only mongoose is valid for direct legacy feature routes today.
# Identity, organizations and authority are a single cutover boundary and may use postgres only
# while PERSISTENCE_LEGACY_API_MODE=disabled. Every unspecified domain defaults to mongoose.
PERSISTENCE_ENVIRONMENT=development
PERSISTENCE_LEGACY_API_MODE=enabled
PERSISTENCE_IDENTITY_STORE=mongoose
PERSISTENCE_ORGANIZATIONS_STORE=mongoose
PERSISTENCE_AUTHORITY_STORE=mongoose
PERSISTENCE_LEARNING_STORE=mongoose
PERSISTENCE_CHALLENGES_STORE=mongoose
PERSISTENCE_COURSES_STORE=mongoose
PERSISTENCE_SOCIAL_STORE=mongoose
PERSISTENCE_IDEAS_STORE=mongoose
PERSISTENCE_INTEGRATIONS_STORE=mongoose

# Optional metadata-only shadow reads. Approval format:
# shadow:<environment>:<database>:<dataset-sha256>:<sorted-comma-domains>
PERSISTENCE_SHADOW_DOMAINS=
PERSISTENCE_SHADOW_APPROVAL=

# Cutover/rollback settings are temporary operator values, never long-lived application secrets.
# Activation approval format:
# cutover:<environment>:<database>:<generation>:<parity-report-sha256>:<sorted-comma-domains>
# Rollback approval format:
# rollback:<environment>:<database>:<generation>:<sorted-comma-domains>
PERSISTENCE_CUTOVER_MODE=
PERSISTENCE_CUTOVER_GENERATION=
PERSISTENCE_CUTOVER_APPROVAL=
PERSISTENCE_ROLLBACK_APPROVAL=
PERSISTENCE_CUTOVER_OPERATOR=
PERSISTENCE_MIGRATION_DATASET_SHA256=
PERSISTENCE_PARITY_REPORT_SHA256=
PERSISTENCE_ROLLBACK_SNAPSHOT_SHA256=
PERSISTENCE_ROLLBACK_UNTIL=
PERSISTENCE_WRITE_FREEZE_CONFIRMED=false
PERSISTENCE_ROLLBACK_REHEARSED=false

# Configure both values (at least 32 random bytes each) to enable the /api/v1 identity API.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_PEPPER=
ACCESS_TOKEN_ISSUER=codewithmee-api
ACCESS_TOKEN_AUDIENCE=codewithmee-web
WEB_APP_ORIGIN=http://127.0.0.1:3000

# One-shot authority bootstrap; supply only while running `npm run bootstrap:superadmin`,
# then remove it. The command is transaction-only, succeeds once, and appends an audit event.
# SUPERADMIN_BOOTSTRAP_EMAIL=verified-existing-user@example.com
# SUPERADMIN_BOOTSTRAP_REASON=Initial authority bootstrap approved by change record
# SUPERADMIN_BOOTSTRAP_OPERATOR=change-record-or-operator-reference

# Defaults to local in development and required k-anonymous screening in production.
PASSWORD_COMPROMISE_CHECK_MODE=

# Empty preserves the current allow-all development behavior. Production must list exact origins.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Exact reverse-proxy source addresses/CIDRs. Empty means forwarding headers are ignored.
# Never use a wildcard; the deployment firewall must also block direct public access to the app.
TRUSTED_PROXY_CIDRS=

# Optional compatibility settings.
DNS_SERVERS=8.8.8.8,1.1.1.1
PISTON_API_URL=http://127.0.0.1:2000/api/v2/execute

# Legacy disk uploads are development-only and production rejects enabling this switch.
LOCAL_UPLOAD_SERVING=true

# Private S3-compatible object storage. Leave FILE_STORAGE_MODE empty to expose an explicit
# unavailable state. Production also requires FILE_SCANNER_MODE=external before files can be ready.
FILE_STORAGE_MODE=
FILE_STORAGE_BUCKET=
FILE_STORAGE_REGION=auto
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_PREFIX=codewithmee/development
FILE_STORAGE_FORCE_PATH_STYLE=false
FILE_STORAGE_ACCESS_KEY_ID=
FILE_STORAGE_SECRET_ACCESS_KEY=
FILE_UPLOAD_TTL_SECONDS=300
FILE_DOWNLOAD_TTL_SECONDS=60
FILE_SCANNER_MODE=disabled
# Required only for the cleanup job; approval must exactly name the configured bucket.
# FILE_CLEANUP_APPROVAL=cleanup:private-bucket-name
FILE_PENDING_RETENTION_HOURS=24
FILE_QUARANTINE_RETENTION_HOURS=168

# Read-only DB/object/legacy-upload reconciliation. No object is deleted by this command.
# Approval: reconcile:<database>:<bucket>:<prefix>
FILE_RECONCILIATION_SCOPE=disposable
FILE_RECONCILIATION_MODE=
FILE_RECONCILIATION_APPROVAL=
FILE_RECONCILIATION_KEY=
LEGACY_UPLOAD_ROOT=
# Optional private JSON array of {pathFingerprint,fileId}; never commit it.
LEGACY_FILE_MAPPING_PATH=

# Optional Google authorization-code + PKCE flow. Configure all four values or none.
# Local callback example: http://127.0.0.1:5001/api/v1/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
OAUTH_TRANSACTION_SECRET=

# Provider keys are optional until their feature is used. Numbered rotation slots are supported.
GEMINI_API_KEY_1=
YOUTUBE_API_KEY_1=
