generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE           @map("active")
  SUSPENDED        @map("suspended")
  BANNED           @map("banned")
  DELETION_PENDING @map("deletion_pending")

  @@map("user_status")
}

enum PlatformRole {
  LEARNER    @map("learner")
  MODERATOR  @map("moderator")
  SUPPORT    @map("support")
  SUPERADMIN @map("superadmin")

  @@map("platform_role")
}

enum AuthorizationScope {
  PLATFORM     @map("platform")
  ORGANIZATION @map("organization")
  COURSE       @map("course")

  @@map("authorization_scope")
}

enum IdentityProvider {
  LOCAL  @map("local")
  GOOGLE @map("google")

  @@map("identity_provider")
}

enum SessionClient {
  WEB       @map("web")
  EXTENSION @map("extension")

  @@map("session_client")
}

enum RefreshTokenState {
  CURRENT  @map("current")
  CONSUMED @map("consumed")

  @@map("refresh_token_state")
}

enum IdentityTokenKind {
  EMAIL_VERIFICATION @map("email_verification")
  PASSWORD_RESET     @map("password_reset")

  @@map("identity_token_kind")
}

enum PkceMethod {
  S256 @map("S256")

  @@map("pkce_method")
}

enum OrganizationVerificationStatus {
  DRAFT          @map("draft")
  PENDING_REVIEW @map("pending_review")
  APPROVED       @map("approved")
  REJECTED       @map("rejected")
  SUSPENDED      @map("suspended")

  @@map("organization_verification_status")
}

enum OrganizationRole {
  OWNER      @map("owner")
  ADMIN      @map("admin")
  INSTRUCTOR @map("instructor")
  GRADER     @map("grader")
  ANALYST    @map("analyst")

  @@map("organization_role")
}

enum MembershipStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")
  REVOKED   @map("revoked")

  @@map("membership_status")
}

enum InvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")
  EXPIRED  @map("expired")

  @@map("invitation_status")
}

enum VerificationReviewStatus {
  PENDING_REVIEW @map("pending_review")
  APPROVED       @map("approved")
  REJECTED       @map("rejected")

  @@map("verification_review_status")
}

enum FileScanStatus {
  PENDING     @map("pending")
  CLEAN       @map("clean")
  INFECTED    @map("infected")
  UNSCANNABLE @map("unscannable")
  FAILED      @map("failed")

  @@map("file_scan_status")
}

enum FileVisibility {
  PRIVATE      @map("private")
  ORGANIZATION @map("organization")
  ENROLLED     @map("enrolled")
  PUBLIC       @map("public")

  @@map("file_visibility")
}

enum FileState {
  UPLOAD_PENDING @map("upload_pending")
  QUARANTINED    @map("quarantined")
  READY          @map("ready")
  DELETED        @map("deleted")

  @@map("file_state")
}

enum JobState {
  PENDING   @map("pending")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  DEAD      @map("dead")

  @@map("job_state")
}

enum ImportRunState {
  INVENTORY  @map("inventory")
  DRY_RUN    @map("dry_run")
  IMPORTING  @map("importing")
  RECONCILED @map("reconciled")
  FAILED     @map("failed")

  @@map("import_run_state")
}

enum ImportRecordState {
  PLANNED     @map("planned")
  IMPORTED    @map("imported")
  QUARANTINED @map("quarantined")
  SKIPPED     @map("skipped")

  @@map("import_record_state")
}

enum ChallengeDifficulty {
  EASY   @map("easy")
  MEDIUM @map("medium")
  HARD   @map("hard")

  @@map("challenge_difficulty")
}

enum ChallengeTestVisibility {
  VISIBLE @map("visible")
  HIDDEN  @map("hidden")

  @@map("challenge_test_visibility")
}

enum CourseVisibility {
  PUBLIC  @map("public")
  PRIVATE @map("private")

  @@map("course_visibility")
}

enum CoursePricing {
  FREE @map("free")
  PAID @map("paid")

  @@map("course_pricing")
}

enum EnrollmentStatus {
  ENROLLED        @map("enrolled")
  IN_PROGRESS     @map("in_progress")
  COMPLETED       @map("completed")
  PENDING_PAYMENT @map("pending_payment")

  @@map("enrollment_status")
}

enum SocialRelationshipStatus {
  REQUESTED @map("requested")
  FOLLOWING @map("following")

  @@map("social_relationship_status")
}

enum IdeaVisibility {
  PRIVATE @map("private")
  PUBLIC  @map("public")

  @@map("idea_visibility")
}

model PermissionDefinition {
  key         String             @id @db.VarChar(120)
  scope       AuthorizationScope
  description String             @db.VarChar(500)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permission_definitions")
}

model RoleDefinition {
  key         String             @id @db.VarChar(120)
  scope       AuthorizationScope
  description String             @db.VarChar(500)
  builtin     Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]

  @@map("role_definitions")
}

model RolePermission {
  roleKey       String               @map("role_key") @db.VarChar(120)
  permissionKey String               @map("permission_key") @db.VarChar(120)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  role          RoleDefinition       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission    PermissionDefinition @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model User {
  id                              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailNormalized                 String                       @unique(map: "users_email_normalized_key") @map("email_normalized") @db.VarChar(320)
  emailDisplay                    String                       @map("email_display") @db.VarChar(320)
  displayName                     String                       @map("display_name") @db.VarChar(120)
  username                        String?                      @unique(map: "users_username_key") @db.VarChar(64)
  status                          UserStatus                   @default(ACTIVE)
  platformRole                    PlatformRole                 @default(LEARNER) @map("platform_role")
  authorityRevision               Int                          @default(1) @map("authority_revision")
  emailVerifiedAt                 DateTime?                    @map("email_verified_at") @db.Timestamptz(6)
  avatarFileId                    String?                      @unique(map: "users_avatar_file_id_key") @map("avatar_file_id") @db.Uuid
  deletionRequestedAt             DateTime?                    @map("deletion_requested_at") @db.Timestamptz(6)
  deletedAt                       DateTime?                    @map("deleted_at") @db.Timestamptz(6)
  createdAt                       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  avatarFile                      FileObject?                  @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: Restrict)
  authIdentities                  AuthIdentity[]
  sessions                        Session[]
  oneTimeTokens                   IdentityOneTimeToken[]
  oauthAuthorizationCodes         OAuthAuthorizationCode[]
  ownedOrganizations              Organization[]               @relation("OrganizationOwner")
  organizationMemberships         OrganizationMembership[]
  sentOrganizationInvitations     OrganizationInvitation[]     @relation("InvitationSender")
  acceptedOrganizationInvitations OrganizationInvitation[]     @relation("InvitationAcceptor")
  submittedVerificationReviews    ProviderVerificationReview[] @relation("VerificationSubmitter")
  reviewedVerificationReviews     ProviderVerificationReview[] @relation("VerificationReviewer")
  uploadedFiles                   FileObject[]                 @relation("FileUploader")
  ownedFiles                      FileObject[]                 @relation("FileOwnerUser")
  auditEvents                     AuditEvent[]                 @relation("AuditActor")
  idempotencyKeys                 IdempotencyKey[]
  featureFlagChanges              FeatureFlag[]                @relation("FeatureFlagUpdater")
  importRuns                      ImportRun[]                  @relation("ImportRunOperator")
  learningProfile                 LearningProfile?
  learningRoadmaps                LearningRoadmap[]
  learningConversations           LearningConversation[]
  learningNotes                   LearningNote[]
  videoProgressEntries            VideoProgress[]
  jobSimulationProgress           JobSimulationProgress[]
  socialProfile                   SocialProfile?
  socialRelationshipsFrom         SocialRelationship[]         @relation("SocialRelationshipSource")
  socialRelationshipsTo           SocialRelationship[]         @relation("SocialRelationshipTarget")
  blocksCreated                   UserBlock[]                  @relation("UserBlockActor")
  blocksReceived                  UserBlock[]                  @relation("UserBlockTarget")
  createdChallenges               Challenge[]                  @relation("ChallengeCreator")
  challengeComments               ChallengeComment[]
  challengeReactions              ChallengeReaction[]
  challengeCommentReactions       ChallengeCommentReaction[]
  challengeBookmarks              ChallengeBookmark[]
  challengeSolves                 ChallengeSolve[]
  courseEnrollments               Enrollment[]
  authoredPosts                   SocialPost[]                 @relation("PostUserAuthor")
  authoredSocialComments          SocialComment[]              @relation("CommentUserAuthor")
  socialPostReactions             SocialPostReaction[]
  socialPostSaves                 SocialPostSave[]
  socialCommentReactions          SocialCommentReaction[]
  socialCommentSaves              SocialCommentSave[]
  authoredIdeas                   Idea[]                       @relation("IdeaUserAuthor")
  authoredIdeaUpdates             IdeaUpdate[]                 @relation("IdeaUpdateUserAuthor")
  ideaReactions                   IdeaReaction[]

  @@index([status, platformRole], map: "users_status_platform_role_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model AuthIdentity {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  provider        IdentityProvider
  providerSubject String           @map("provider_subject") @db.VarChar(320)
  passwordHash    String?          @map("password_hash") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], map: "auth_identities_provider_subject_key")
  @@unique([userId, provider], map: "auth_identities_user_provider_key")
  @@index([userId], map: "auth_identities_user_id_idx")
  @@map("auth_identities")
}

model Session {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  client            SessionClient
  familyId          String                @unique(map: "sessions_family_id_key") @map("family_id") @db.Uuid
  authenticatedAt   DateTime              @map("authenticated_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime              @map("absolute_expires_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime              @map("idle_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  compromisedAt     DateTime?             @map("compromised_at") @db.Timestamptz(6)
  lastUsedAt        DateTime              @map("last_used_at") @db.Timestamptz(6)
  deviceLabel       String?               @map("device_label") @db.VarChar(120)
  userAgentHash     String?               @map("user_agent_hash") @db.Char(64)
  ipPrefix          String?               @map("ip_prefix") @db.VarChar(80)
  csrfSecretHash    String                @map("csrf_secret_hash") @db.Char(64)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens     SessionRefreshToken[]

  @@index([userId, revokedAt, idleExpiresAt], map: "sessions_user_active_expiry_idx")
  @@index([absoluteExpiresAt], map: "sessions_absolute_expiry_idx")
  @@map("sessions")
}

model SessionRefreshToken {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String               @map("session_id") @db.Uuid
  tokenHash         String               @unique(map: "session_refresh_tokens_hash_key") @map("token_hash") @db.Char(64)
  state             RefreshTokenState    @default(CURRENT)
  issuedAt          DateTime             @map("issued_at") @db.Timestamptz(6)
  expiresAt         DateTime             @map("expires_at") @db.Timestamptz(6)
  consumedAt        DateTime?            @map("consumed_at") @db.Timestamptz(6)
  replacedByTokenId String?              @unique(map: "session_refresh_tokens_replaced_by_key") @map("replaced_by_token_id") @db.Uuid
  session           Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy        SessionRefreshToken? @relation("RefreshRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replaces          SessionRefreshToken? @relation("RefreshRotation")

  @@index([sessionId, state, expiresAt], map: "session_refresh_tokens_session_state_expiry_idx")
  @@map("session_refresh_tokens")
}

model IdentityOneTimeToken {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String            @map("user_id") @db.Uuid
  kind       IdentityTokenKind
  tokenHash  String            @unique(map: "identity_one_time_tokens_hash_key") @map("token_hash") @db.Char(64)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, expiresAt], map: "identity_one_time_tokens_user_kind_expiry_idx")
  @@map("identity_one_time_tokens")
}

model OAuthClient {
  id                 String                   @id @db.VarChar(128)
  name               String                   @db.VarChar(120)
  publicClient       Boolean                  @default(true) @map("public_client")
  redirectUris       Json                     @map("redirect_uris") @db.JsonB
  allowedScopes      Json                     @map("allowed_scopes") @db.JsonB
  active             Boolean                  @default(true)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  authorizationCodes OAuthAuthorizationCode[]

  @@map("oauth_clients")
}

model OAuthAuthorizationCode {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeHash      String      @unique(map: "oauth_authorization_codes_hash_key") @map("code_hash") @db.Char(64)
  clientId      String      @map("client_id") @db.VarChar(128)
  userId        String      @map("user_id") @db.Uuid
  redirectUri   String      @map("redirect_uri") @db.VarChar(2048)
  scopes        Json        @db.JsonB
  pkceChallenge String      @map("pkce_challenge") @db.VarChar(128)
  pkceMethod    PkceMethod  @default(S256) @map("pkce_method")
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt], map: "oauth_authorization_codes_client_expiry_idx")
  @@index([userId, expiresAt], map: "oauth_authorization_codes_user_expiry_idx")
  @@map("oauth_authorization_codes")
}

model Organization {
  id                  String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String                         @unique(map: "organizations_slug_key") @db.VarChar(80)
  name                String                         @db.VarChar(160)
  description         String?                        @db.VarChar(2000)
  industry            String?                        @db.VarChar(120)
  ownerUserId         String                         @map("owner_user_id") @db.Uuid
  logoFileId          String?                        @unique(map: "organizations_logo_file_id_key") @map("logo_file_id") @db.Uuid
  verificationStatus  OrganizationVerificationStatus @default(DRAFT) @map("verification_status")
  revision            Int                            @default(1)
  deletedAt           DateTime?                      @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner               User                           @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  logoFile            FileObject?                    @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: Restrict)
  memberships         OrganizationMembership[]
  invitations         OrganizationInvitation[]
  verificationReviews ProviderVerificationReview[]
  ownedFiles          FileObject[]                   @relation("FileOwnerOrganization")
  auditEvents         AuditEvent[]
  courses             Course[]
  authoredPosts       SocialPost[]                   @relation("PostOrganizationAuthor")
  authoredComments    SocialComment[]                @relation("CommentOrganizationAuthor")
  authoredIdeas       Idea[]                         @relation("IdeaOrganizationAuthor")
  authoredIdeaUpdates IdeaUpdate[]                   @relation("IdeaUpdateOrganizationAuthor")

  @@index([verificationStatus, createdAt], map: "organizations_verification_created_idx")
  @@index([ownerUserId], map: "organizations_owner_user_id_idx")
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  revision       Int              @default(1)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  suspendedAt    DateTime?        @map("suspended_at") @db.Timestamptz(6)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId], map: "organization_memberships_org_user_key")
  @@index([userId, status], map: "organization_memberships_user_status_idx")
  @@index([organizationId, role, status], map: "organization_memberships_org_role_status_idx")
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  emailNormalized  String           @map("email_normalized") @db.VarChar(320)
  role             OrganizationRole
  status           InvitationStatus @default(PENDING)
  tokenHash        String           @unique(map: "organization_invitations_hash_key") @map("token_hash") @db.Char(64)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt], map: "organization_invitations_org_status_expiry_idx")
  @@index([emailNormalized, status], map: "organization_invitations_email_status_idx")
  @@map("organization_invitations")
}

model ProviderVerificationReview {
  id                String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                         @map("organization_id") @db.Uuid
  submittedByUserId String                         @map("submitted_by_user_id") @db.Uuid
  reviewerUserId    String?                        @map("reviewer_user_id") @db.Uuid
  statement         String                         @db.VarChar(2000)
  status            VerificationReviewStatus       @default(PENDING_REVIEW)
  decisionReason    String?                        @map("decision_reason") @db.VarChar(2000)
  submittedAt       DateTime                       @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt        DateTime?                      @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy       User                           @relation("VerificationSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  reviewer          User?                          @relation("VerificationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  evidence          ProviderVerificationEvidence[]

  @@index([status, submittedAt], map: "provider_verification_reviews_status_submitted_idx")
  @@index([organizationId, createdAt], map: "provider_verification_reviews_org_created_idx")
  @@map("provider_verification_reviews")
}

model ProviderVerificationEvidence {
  reviewId  String                     @map("review_id") @db.Uuid
  fileId    String                     @map("file_id") @db.Uuid
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  review    ProviderVerificationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  file      FileObject                 @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@id([reviewId, fileId])
  @@index([fileId], map: "provider_verification_evidence_file_id_idx")
  @@map("provider_verification_evidence")
}

model FileObject {
  id                      String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId             String?                        @map("owner_user_id") @db.Uuid
  ownerOrganizationId     String?                        @map("owner_organization_id") @db.Uuid
  uploadedByUserId        String                         @map("uploaded_by_user_id") @db.Uuid
  purpose                 String                         @db.VarChar(80)
  storageProvider         String                         @default("s3") @map("storage_provider") @db.VarChar(32)
  storageBucket           String                         @map("storage_bucket") @db.VarChar(255)
  storageKey              String                         @unique(map: "files_storage_key_key") @map("storage_key") @db.VarChar(1024)
  originalName            String                         @map("original_name") @db.VarChar(255)
  declaredMime            String                         @map("declared_mime") @db.VarChar(255)
  detectedMime            String?                        @map("detected_mime") @db.VarChar(255)
  byteSize                BigInt                         @map("byte_size")
  sha256                  String?                        @db.Char(64)
  etag                    String?                        @db.VarChar(255)
  state                   FileState                      @default(UPLOAD_PENDING)
  scanStatus              FileScanStatus                 @default(PENDING) @map("scan_status")
  visibility              FileVisibility                 @default(PRIVATE)
  uploadedAt              DateTime?                      @map("uploaded_at") @db.Timestamptz(6)
  scannedAt               DateTime?                      @map("scanned_at") @db.Timestamptz(6)
  quarantineReason        String?                        @map("quarantine_reason") @db.VarChar(500)
  deletedAt               DateTime?                      @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerUser               User?                          @relation("FileOwnerUser", fields: [ownerUserId], references: [id], onDelete: Restrict)
