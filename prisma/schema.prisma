  title              String           @db.VarChar(255)
  description        String?          @db.Text
  thumbnailLegacyUrl String?          @map("thumbnail_legacy_url") @db.VarChar(2048)
  visibility         CourseVisibility @default(PUBLIC)
  pricing            CoursePricing    @default(FREE)
  priceMinor         Int?             @map("price_minor")
  currency           String?          @db.Char(3)
  category           String?          @db.VarChar(120)
  tags               Json             @default("[]") @db.JsonB
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions           CourseVersion[]
  enrollments        Enrollment[]

  @@index([organizationId, active], map: "courses_organization_active_idx")
  @@index([visibility, createdAt], map: "courses_visibility_created_idx")
  @@index([tags], map: "courses_tags_gin_idx", type: Gin)
  @@map("courses")
}

model CourseVersion {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId  String         @map("course_id") @db.Uuid
  version   Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules   CourseModule[]

  @@unique([courseId, version], map: "course_versions_course_version_key")
  @@map("course_versions")
}

model CourseModule {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId   String          @map("version_id") @db.Uuid
  title       String          @db.VarChar(255)
  description String?         @db.Text
  position    Int             @default(0)
  version     CourseVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  contents    CourseContent[]

  @@unique([versionId, position], map: "course_modules_version_position_key")
  @@map("course_modules")
}

model CourseContent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId      String       @map("module_id") @db.Uuid
  kind          String       @db.VarChar(32)
  title         String       @db.VarChar(255)
  legacyUrl     String?      @map("legacy_url") @db.VarChar(2048)
  body          String?      @db.Text
  allowDownload Boolean      @default(false) @map("allow_download")
  position      Int          @default(0)
  module        CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, position], map: "course_contents_module_position_key")
  @@map("course_contents")
}

model Enrollment {
  id             String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                        @map("user_id") @db.Uuid
  courseId       String                        @map("course_id") @db.Uuid
  status         EnrollmentStatus              @default(ENROLLED)
  enrolledAt     DateTime                      @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  completedAt    DateTime?                     @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  course         Course                        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  importSnapshot CourseProgressImportSnapshot?

  @@unique([userId, courseId], map: "enrollments_user_course_key")
  @@index([courseId, status], map: "enrollments_course_status_idx")
  @@map("enrollments")
}

model CourseProgressImportSnapshot {
  enrollmentId       String     @id @map("enrollment_id") @db.Uuid
  progressPercent    Int        @map("progress_percent")
  completedSourceIds Json       @map("completed_source_ids") @db.JsonB
  authoritative      Boolean    @default(false)
  importedAt         DateTime   @default(now()) @map("imported_at") @db.Timestamptz(6)
  enrollment         Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("course_progress_import_snapshots")
}

model SocialPost {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorUserId         String?              @map("author_user_id") @db.Uuid
  authorOrganizationId String?              @map("author_organization_id") @db.Uuid
  content              String               @db.Text
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  authorUser           User?                @relation("PostUserAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  authorOrganization   Organization?        @relation("PostOrganizationAuthor", fields: [authorOrganizationId], references: [id], onDelete: Restrict)
  media                SocialPostMedia[]
  comments             SocialComment[]
  reactions            SocialPostReaction[]
  saves                SocialPostSave[]

  @@index([createdAt, id], map: "social_posts_created_idx")
  @@index([authorUserId, createdAt], map: "social_posts_user_created_idx")
  @@index([authorOrganizationId, createdAt], map: "social_posts_org_created_idx")
  @@map("social_posts")
}

model SocialPostMedia {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String      @map("post_id") @db.Uuid
  fileId    String?     @map("file_id") @db.Uuid
  kind      String      @db.VarChar(32)
  legacyUrl String?     @map("legacy_url") @db.VarChar(2048)
  position  Int         @default(0)
  post      SocialPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  file      FileObject? @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([postId, position], map: "social_post_media_post_position_key")
  @@index([fileId], map: "social_post_media_file_idx")
  @@map("social_post_media")
}

model SocialComment {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId               String                  @map("post_id") @db.Uuid
  parentId             String?                 @map("parent_id") @db.Uuid
  authorUserId         String?                 @map("author_user_id") @db.Uuid
  authorOrganizationId String?                 @map("author_organization_id") @db.Uuid
  content              String                  @db.Text
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  post                 SocialPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent               SocialComment?          @relation("SocialCommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies              SocialComment[]         @relation("SocialCommentTree")
  authorUser           User?                   @relation("CommentUserAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  authorOrganization   Organization?           @relation("CommentOrganizationAuthor", fields: [authorOrganizationId], references: [id], onDelete: Restrict)
  reactions            SocialCommentReaction[]
  saves                SocialCommentSave[]

  @@index([postId, createdAt], map: "social_comments_post_created_idx")
  @@index([parentId], map: "social_comments_parent_idx")
  @@map("social_comments")
}

model SocialPostReaction {
  postId    String     @map("post_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  kind      String     @db.VarChar(32)
  awardType String?    @map("award_type") @db.VarChar(32)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, kind])
  @@map("social_post_reactions")
}

model SocialPostSave {
  postId    String     @map("post_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("social_post_saves")
}

model SocialCommentReaction {
  commentId String        @map("comment_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      String        @db.VarChar(32)
  awardType String?       @map("award_type") @db.VarChar(32)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId, kind])
  @@map("social_comment_reactions")
}

model SocialCommentSave {
  commentId String        @map("comment_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  comment   SocialComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("social_comment_saves")
}

model Idea {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorUserId         String?         @map("author_user_id") @db.Uuid
  authorOrganizationId String?         @map("author_organization_id") @db.Uuid
  title                String          @db.VarChar(255)
  description          String          @db.Text
  techStack            Json            @default("[]") @map("tech_stack") @db.JsonB
  visibility           IdeaVisibility  @default(PUBLIC)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  authorUser           User?           @relation("IdeaUserAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  authorOrganization   Organization?   @relation("IdeaOrganizationAuthor", fields: [authorOrganizationId], references: [id], onDelete: Restrict)
  milestones           IdeaMilestone[]
  updates              IdeaUpdate[]
  reactions            IdeaReaction[]

  @@index([visibility, createdAt], map: "ideas_visibility_created_idx")
  @@index([authorUserId, createdAt], map: "ideas_user_created_idx")
  @@index([authorOrganizationId, createdAt], map: "ideas_org_created_idx")
  @@index([techStack], map: "ideas_tech_stack_gin_idx", type: Gin)
  @@map("ideas")
}

model IdeaMilestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ideaId      String    @map("idea_id") @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @db.Text
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  position    Int       @default(0)
  idea        Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([ideaId, position], map: "idea_milestones_idea_position_key")
  @@map("idea_milestones")
}

model IdeaUpdate {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ideaId               String        @map("idea_id") @db.Uuid
  authorUserId         String?       @map("author_user_id") @db.Uuid
  authorOrganizationId String?       @map("author_organization_id") @db.Uuid
  title                String        @db.VarChar(255)
  body                 String        @db.Text
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  idea                 Idea          @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  authorUser           User?         @relation("IdeaUpdateUserAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  authorOrganization   Organization? @relation("IdeaUpdateOrganizationAuthor", fields: [authorOrganizationId], references: [id], onDelete: Restrict)

  @@index([ideaId, createdAt], map: "idea_updates_idea_created_idx")
  @@map("idea_updates")
}

model IdeaReaction {
  ideaId    String   @map("idea_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String   @default("like") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
  @@map("idea_reactions")
}

model IntegrationCache {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider  String   @db.VarChar(40)
  keyHash   String   @map("key_hash") @db.Char(64)
  value     Json     @db.JsonB
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, keyHash], map: "integration_cache_provider_key_hash_key")
  @@index([expiresAt], map: "integration_cache_expires_idx")
  @@map("integration_cache")
}
